# BabyPhone backend configuration
PORT=5000
NODE_ENV=production

# --- Firebase Admin credentials ---
# Option A (recommended for local dev): drop the service-account JSON at
#   backend/firebase-admin.json   (it is gitignored)
#
# Option B (recommended for Railway/Render): set these three vars instead.
# Keep the quotes around the private key and keep the literal \n escapes.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
