# ============================================================
# BABYROAD — Template variables d'environnement
# NE JAMAIS committer le vrai .env (déjà dans .gitignore)
#
# Note : dispatcher/ et tracker/ sont des sites 100% statiques —
# les clés se renseignent dans dispatcher/js/config.js,
# tracker/config.js et android-app/src/config.js (clé ANON
# uniquement, safe côté client car protégée par RLS).
# Ce fichier sert de référence centrale des valeurs.
# ============================================================

# ── Supabase (projet hôte des tables babyroad_*) ────────────
SUPABASE_URL=https://fpntzgrocuiiqjixtbuo.supabase.co
SUPABASE_ANON_KEY=
# SERVICE KEY : BACKEND UNIQUEMENT (Edge Functions) — jamais côté client
SUPABASE_SERVICE_KEY=

# ── TomTom (source trafic UNIQUE) ───────────────────────────
# Compte gratuit : https://developer.tomtom.com — 2 500 req/jour
TOMTOM_API_KEY=

# ── Carte (optionnel — fallback OpenFreeMap sans clé) ───────
# Compte gratuit : https://cloud.maptiler.com — 100k tiles/mois
MAPTILER_KEY=

# ── Config GPS ──────────────────────────────────────────────
GPS_INTERVAL_MOVING_MS=30000
GPS_INTERVAL_IDLE_MS=120000
GPS_INTERVAL_CRITICAL_MS=10000
GPS_ACCURACY_MAX_M=50
IMMOBILE_ALERT_MINUTES=10
LOW_BATTERY_THRESHOLD=20
TRAJECTORY_POINTS_MAX=50
